{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // Outputs
    "sourceMap": true,
    "outDir": "./dist",
    // Recommended
    "moduleDetection": "force",
    "skipLibCheck": true,
    // Incremental migration settings
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "jsx": "react-jsx",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "node"
    ],
    // Module / target
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "packages"
  ]
}
