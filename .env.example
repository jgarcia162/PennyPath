# Copy to .env (same folder as package.json).
# Get an API key: https://aistudio.google.com/apikey
# Used by npm run research-server: real-estate AI research + Financial Plan “AI payoff plan”.
GEMINI_API_KEY=paste-your-key-here

# Optional: default is gemini-2.5-flash (see https://ai.google.dev/gemini-api/docs/models)
# GEMINI_MODEL=gemini-2.5-flash

# CORS for npm run research-server (see server/market-research.mjs): loopback browser origins
# (http://127.0.0.1:*, localhost, ::1) are allowed without this. For a static site on another
# origin (e.g. GitHub Pages) calling your API, list each full origin here or the server returns
# 403 for that browser Origin header. Comma-separated. Optional if you only use loopback.
# Example:
# CORS_ALLOWED_ORIGINS=https://yourname.github.io,http://localhost:3000

# Optional: include full API key in JSON error responses (local debugging only).
# DEBUG_API_KEY_IN_ERRORS=1
